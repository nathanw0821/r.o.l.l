{
  "mcpServers": {
    "roll-neon": {
      "type": "stdio",
      "command": "node",
      "args": ["${workspaceFolder}/scripts/mcp/neon-mcp.mjs"],
      "env": {
        "MCP_MODE": "${env:MCP_MODE}"
      },
      "envFile": "${workspaceFolder}/.env.mcp.local"
    },
    "roll-git": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-git", "${workspaceFolder}"]
    }
  }
}
